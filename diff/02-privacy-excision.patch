-          ge_p1p1_to_p2(&p2, &p1);
-      }
-skipfirst:
-      i -= STRAUS_C;
-      for (size_t j = start_offset; j < start_offset + num_points; ++j)
-      {
-#ifdef TRACK_STRAUS_ZERO_IDENTITY
-        if (skip[j])
-          continue;
-#endif
-#if STRAUS_C==4
-        const uint8_t digit = digits[j*64+i/4];
-#else
-        const uint8_t digit = digits[j*256+i];
-#endif
-        if (digit)
