-/* Given a scalar, construct a vector of powers */
-static rct::keyV vector_powers(const rct::key &x, size_t n)
-{
-  rct::keyV res(n);
-  if (n == 0)
-    return res;
-  res[0] = rct::identity();
-  if (n == 1)
-    return res;
-  res[1] = x;
-  for (size_t i = 2; i < n; ++i)
-  {
-    sc_mul(res[i].bytes, res[i-1].bytes, x.bytes);
-  }
-  return res;
-}
