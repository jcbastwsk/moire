-      require_connected();
-      device_state_initialize_unsafe();
-      require_initialized();
-
-      auto req = std::make_shared<messages::monero::MoneroGetAddress>();
-      this->set_msg_addr<messages::monero::MoneroGetAddress>(req.get(), path, network_type);
