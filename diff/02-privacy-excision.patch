-        keyV tmp(rows + 1);
-        keyV sk(rows + 1);
-        keyM M(cols, tmp);
-
-        keyV P, C, C_nonzero;
-        P.reserve(pubs.size());
-        C.reserve(pubs.size());
-        C_nonzero.reserve(pubs.size());
-        for (const ctkey &k: pubs)
