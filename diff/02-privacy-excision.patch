-            byte = 0;
-            for (i = 7; i > -1; i--) {
-                byte = byte * 2 + amountb2[8 * j + i];
-            }
-            amountdh[j] = (unsigned char)byte;
-        }
-        for (j = 8; j < 32; j++) {
-            amountdh[j] = (unsigned char)(0x00);
-        }
-    }
