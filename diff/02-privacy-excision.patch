-        multiexp_data.reserve(a.size()*2);
-        for (size_t i = 0; i < a.size(); ++i)
-        {
-            multiexp_data.emplace_back(a[i], Gi_p3[i]);
-            multiexp_data.emplace_back(b[i], Hi_p3[i]);
-        }
-        return multiexp(multiexp_data, 2 * a.size());
