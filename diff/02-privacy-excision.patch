-      data.append(MULTISIG_KEX_MSG_V2_MAGIC_N.data(), MULTISIG_KEX_MSG_V2_MAGIC_N.size());
-
-    // kex_round as little-endian bytes
-    for (std::size_t i{0}; i < 4; ++i)
