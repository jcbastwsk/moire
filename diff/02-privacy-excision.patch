-    {
-      auto req = std::make_shared<messages::monero::MoneroLiveRefreshFinalRequest>();
-      this->client_exchange<messages::monero::MoneroLiveRefreshFinalAck>(req);
-      m_live_refresh_in_progress = false;
-    }
