-    //32 byte key to int[64]
-    void h2b(bits amountb2, const key & test) {
-        int val = 0, i = 0, j = 0;
-        for (j = 0; j < 8; j++) {
-            val = (unsigned char)test.bytes[j];
-            i = 0;
-            while (i < 8) {
-                amountb2[j*8+i++] = val & 1;
-                val >>= 1;
-            }
-        }
-    }
