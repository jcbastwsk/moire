@@ -0,0 +1,32 @@
+// Moire — Proof-of-Activity oracle.
+// Pure function over the rolling 720-block activity ledger. State lives in blockchain_db.
+#pragma once
+
+#include <cstdint>
+#include "crypto/crypto.h"
+
+namespace moire {
+
+struct poa_params {
+  double alpha   = 0.5;   // V_tx weight
+  double beta    = 0.4;   // R_contrib weight
+  double gamma   = 0.1;   // P_stake weight
+  double epsilon = 1e-6;  // activity floor
+};
+
+struct activity_window {
+  uint64_t height_lo;        // inclusive
+  uint64_t height_hi;        // inclusive (window end)
+  uint64_t fee_burnt_atomic; // sum of burnt fees over window (attomoire)
+  uint64_t fee_target_atomic;// genesis: 1 MOI/block * window_len
+  uint32_t reduce_tx_count;  // accepted reduce(ΔC) txs in window
+  uint32_t reduce_tx_target; // genesis-tunable cap, default 4 in 720
+  double   stake_weight;     // sum of stake-weighted attestation weights
+  double   stake_weight_max; // genesis: registry sum
+};
+
+double activity_score(const activity_window& w, const poa_params& p) noexcept;
+struct poa_params poa_params_post_transition(const poa_params& p) noexcept;
+crypto::hash activity_ledger_hash(const activity_window& w) noexcept;
+
+}  // namespace moire
