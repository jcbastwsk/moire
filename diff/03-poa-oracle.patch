diff --git a/src/cryptonote_core/poa_oracle.cpp b/src/cryptonote_core/poa_oracle.cpp
new file mode 100644
index 0000000..66ebead
--- /dev/null
+++ b/src/cryptonote_core/poa_oracle.cpp
@@ -0,0 +1,60 @@
+// Moire — Proof-of-Activity oracle implementation.
+#include "poa_oracle.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "common/util.h"
+#include "crypto/hash.h"
+
+namespace moire {
+
+static inline double clamp01(double x) noexcept {
+  return std::max(0.0, std::min(1.0, x));
+}
+
+double activity_score(const activity_window& w, const poa_params& p) noexcept {
+  const double v_tx =
+      w.fee_target_atomic == 0
+          ? 0.0
+          : clamp01(static_cast<double>(w.fee_burnt_atomic) /
+                    static_cast<double>(w.fee_target_atomic));
+  const double r_contrib =
+      w.reduce_tx_target == 0
+          ? 0.0
+          : clamp01(static_cast<double>(w.reduce_tx_count) /
+                    static_cast<double>(w.reduce_tx_target));
+  const double p_stake =
+      w.stake_weight_max == 0.0
+          ? 0.0
+          : clamp01(w.stake_weight / w.stake_weight_max);
+
+  const double a = p.alpha * v_tx + p.beta * r_contrib + p.gamma * p_stake;
+  return std::max(p.epsilon, std::min(1.0, a));
+}
+
+poa_params poa_params_post_transition(const poa_params& p) noexcept {
+  poa_params q = p;
+  q.alpha = 0.0;
+  q.gamma = 0.0;
+  return q;
+}
+
+crypto::hash activity_ledger_hash(const activity_window& w) noexcept {
+  unsigned char buf[sizeof(uint64_t) * 4 + sizeof(uint32_t) * 2 + sizeof(double) * 2];
+  unsigned char* q = buf;
+  std::memcpy(q, &w.height_lo, sizeof(uint64_t));         q += sizeof(uint64_t);
+  std::memcpy(q, &w.height_hi, sizeof(uint64_t));         q += sizeof(uint64_t);
+  std::memcpy(q, &w.fee_burnt_atomic, sizeof(uint64_t));  q += sizeof(uint64_t);
+  std::memcpy(q, &w.fee_target_atomic, sizeof(uint64_t)); q += sizeof(uint64_t);
+  std::memcpy(q, &w.reduce_tx_count, sizeof(uint32_t));   q += sizeof(uint32_t);
+  std::memcpy(q, &w.reduce_tx_target, sizeof(uint32_t));  q += sizeof(uint32_t);
+  std::memcpy(q, &w.stake_weight, sizeof(double));        q += sizeof(double);
+  std::memcpy(q, &w.stake_weight_max, sizeof(double));    q += sizeof(double);
+
+  crypto::hash h{};
+  crypto::cn_fast_hash(buf, sizeof(buf), h);
+  return h;
+}
+
+}  // namespace moire
