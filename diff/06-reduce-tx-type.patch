+// Moire — reduce(ΔC) canary state machine implementation.
+#include "reduce_tx.h"
+
+#include <cstring>
+
+namespace moire {
+
+bool reduce_tx_admissible(const reduce_tx_state& /*st*/,
+                          const crypto::hash& /*current_cumulative_root*/) noexcept {
+  // Day-1 stub: signature/parent-hash check happens in cryptonote_core::check_tx_inputs.
+  // Return true here; the full predicate runs there once the integration sweep is done.
+  return true;
+}
+
+bool reduce_tx_promotable(const reduce_tx_state& st, uint64_t current_height) noexcept {
+  if (st.status != canary_status::pending) return false;
+  if (current_height < st.canary_window_start + K_CANARY_BLOCKS) return false;
+  if (st.consensus_divergence) return false;
+  if (!st.invariants_passed_continuously) return false;
+  if (st.observed_peer_asns < MIN_CANARY_PEER_ASNS) return false;
+  return true;
+}
+
+}  // namespace moire
diff --git a/src/cryptonote_core/reduce_tx.h b/src/cryptonote_core/reduce_tx.h
new file mode 100644
index 0000000..b98784f
--- /dev/null
+++ b/src/cryptonote_core/reduce_tx.h
@@ -0,0 +1,33 @@
+// Moire — reduce(ΔC) tx canary-then-promote state machine.
+// Constitution Articles V, VI, VIII.
+#pragma once
+
+#include <cstdint>
+#include "crypto/crypto.h"
+
+namespace moire {
+
+constexpr uint64_t K_CANARY_BLOCKS = 2016;             // ~2 weeks @ 60s
+constexpr uint32_t MIN_CANARY_PEER_ASNS = 4;
+constexpr uint64_t MIN_STAKE_ATOMIC = 100000000000000ULL;  // 100 MOI in attomoire
+
+enum class canary_status : uint8_t {
+  pending  = 0,
+  promoted = 1,
+  reverted = 2,
+};
+
+struct reduce_tx_state {
+  crypto::hash patch_blob_hash;
+  uint64_t     canary_window_start;
+  uint32_t     observed_peer_asns;
+  bool         consensus_divergence;
+  bool         invariants_passed_continuously;
+  canary_status status;
+};
+
+bool reduce_tx_admissible(const reduce_tx_state& st,
+                          const crypto::hash& current_cumulative_root) noexcept;
+bool reduce_tx_promotable(const reduce_tx_state& st, uint64_t current_height) noexcept;
+
+}  // namespace moire
