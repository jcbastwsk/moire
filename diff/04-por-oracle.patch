+++ b/src/cryptonote_core/por_oracle.h
@@ -0,0 +1,51 @@
+// Moire — Proof-of-Reduction oracle.
+//
+// Pure header. The oracle computes H(C) and ΔH = H(C) - H(C ⊕ ΔC) where:
+//
+//   H(C) = w_brotli * Brotli11(canon(C))
+//        + w_ast    * AST_node_count(C)
+//        + w_proof  * |proof(C)|
+//
+// canon(C) excludes external/randomx, external/lmdb, build/.
+// Tree-sitter C++ grammar pinned by hash in genesis/toolchain.merkle.json.
+// Brotli pinned by hash in same.
+//
+// Behavioral-equivalence floor (constitution Article VI) is checked separately
+// in cryptonote_core::check_reduce_tx_admissible(); this header only computes H.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "crypto/crypto.h"
+
+namespace moire {
+
+struct por_weights {
+  double w_brotli = 0.6;
+  double w_ast    = 0.3;
+  double w_proof  = 0.1;
+};
+
+struct codebase_snapshot {
+  crypto::hash root;                    // Merkle root of canon(C) at this height
+  uint64_t brotli_size_bytes = 0;       // Brotli-11 size of canon(C)
+  uint64_t ast_node_count = 0;          // tree-sitter AST node count over canon(C)
+  uint64_t proof_size_bytes = 0;        // length of proof artifacts at this height
+};
+
+double codebase_entropy(const codebase_snapshot& c, const por_weights& w) noexcept;
+double reduction_rate(const codebase_snapshot& parent,
+                      const codebase_snapshot& child,
+                      uint64_t patch_size_bytes,
+                      const por_weights& w) noexcept;
+bool transition_predicate(double avg_reduction_rate,
+                          double avg_activity_score,
+                          double theta = 2.0) noexcept;
+crypto::hash extend_cumulative_root(const crypto::hash& parent_root,
+                                    const crypto::hash& patch_blob_hash,
+                                    const codebase_snapshot& child) noexcept;
+
+}  // namespace moire
